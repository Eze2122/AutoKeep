{
  "expo": {
    "name": "AutoKeep",
    "slug": "autokeep",
    "scheme": "autokeep",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#F5F7FA"
        }
      ]
    ],
    "android": {
      "package": "com.eze2122.autokeep",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F5F7FA"
      }
    },
    "ios": {
      "bundleIdentifier": "com.eze2122.autokeep"
    }
  }
}